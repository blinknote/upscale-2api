# 必需
SUPABASE_ANON=
ADMIN_KEY=change-me-admin
# 下游客户端使用的初始 key（逗号分隔，可留空，后续用 /admin/api/keys 生成）
API_KEYS=
# 监听
PORT=8787
HOST=127.0.0.1
# 本服务对外地址，用于拼接 /files/xxx
PUBLIC_BASE_URL=
# 每账号并发（站点硬上限 2）
PER_ACCOUNT_CONCURRENCY=2
# 排队等待上限
QUEUE_WAIT_MS=90000
# 默认模型
DEFAULT_MODEL=nano-banana
# 后台刷新：扫描间隔 / 提前刷新窗口
KEEPALIVE_MS=300000
REFRESH_WINDOW_MS=900000
# 生成产物保留天数（0 = 永久）
FILE_RETENTION_DAYS=30
# 请求日志保留条数
LOG_RING=500
